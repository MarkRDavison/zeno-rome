@attribute [Authorize(Roles = RoleConstants.User)]
@attribute [Route(Routes.UserSettings)]

@inherits BaseView<UserSettingsViewModel, object?>

<AuthorizeView>
    <Authorized>
        <MudStack Spacing="4">
            <MudText Typo="Typo.h5">User Settings</MudText>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Dashboard</MudText>
                @if (ViewModel.Loading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else
                {
                    <MudNumericField T="int"
                                     data-testid="user-settings-recent-count"
                                     Label="Recent transactions on home"
                                     Min="@ViewModel.HomeRecentTransactionCountMin"
                                     Max="@ViewModel.HomeRecentTransactionCountMax"
                                     HelperText="@($"Between {ViewModel.HomeRecentTransactionCountMin} and {ViewModel.HomeRecentTransactionCountMax}")"
                                     @bind-Value="ViewModel.HomeRecentTransactionCount" />
                    <MudButton data-testid="user-settings-save"
                               Class="mt-4"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@ViewModel.Saving"
                               OnClick="@ViewModel.SaveAsync">Save</MudButton>
                }
            </MudPaper>

            <MudPaper Class="pa-4">
                <span>@($"You are currently logged in with {context.User.FindFirst("loggedInProvider")?.Value}")</span><br />
                <span>These are all the identity providers that are linked to this account</span><br />
                <ul>
                    @foreach (var linkedProvider in context.User.FindAll("provider"))
                    {
                        <li>@linkedProvider.Value</li>
                    }
                </ul><br />
                <span>These are all the roles you have</span> <br />
                <ul>
                    @foreach (var role in context.User.FindAll(ClaimTypes.Role))
                    {
                        <li>@role.Value</li>
                    }
                </ul>
            </MudPaper>
        </MudStack>
    </Authorized>
</AuthorizeView>
