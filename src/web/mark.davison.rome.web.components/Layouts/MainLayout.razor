@inherits LayoutComponentBase

@implements IDisposable

@inject AuthenticationStateProvider _auth
@inject NavigationManager _navigationManager
@inject IAuthenticationService _authenticationService
@inject IClientHttpRepository _clientRepository;
@inject IStartupState _startupState
@inject ICategoryState _categoryState
@inject ITagState _tagState
@inject IAppContextService _appContext
@inject IAppSessionBootstrap _appSessionBootstrap
@inject ITagManagerShell _tagManagerShell
@inject IDialogService _dialogService
@inject IBrowserViewportService _viewportService

<MudThemeProvider @ref="@_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        @if (_tagManagerShell.IsOpen && !_useDialogBreakpoint)
        {
            <MudIconButton data-testid="@DataTestIds.TagClose" Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start" OnClick="CloseTagManager" />
        }
        else if (!string.IsNullOrEmpty(_navigationManager.ToBaseRelativePath(_navigationManager.Uri)))
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Edge="Edge.Start" Href="@Routes.Dashboard" />
        }
        <MudText Typo="Typo.h4" Class="app-title">Finance</MudText>
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
                <MudSpacer />
                <AppContext ClaimsPrincipal="@context.User" />
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Size="Size.Large">
                    <ActivatorContent Context="activatorContext">
                        <MudIconButton data-testid="@DataTestIds.ManageIcon" Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Edge="Edge.End" />
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="@Routes.UserSettings">Settings</MudMenuItem>
                        @if (context.User.IsInRole(RoleConstants.Admin))
                        {
                            <MudDivider />
                            <MudMenuItem Href="@Routes.AdminSettings">Admin Settings</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Href="@($"{_authenticationService.BffRoot}/account/logout")">Logout</MudMenuItem>
                    </ChildContent>
                </MudMenu>
                <MudIconButton data-testid="@DataTestIds.QuickCreate" Icon="@Icons.Material.Filled.Add" Color="Color.Inherit" Edge="Edge.End" OnClick="@((e) => QuickAddToggle())" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <AuthorizeView>
        <Authorized>
            <MudDrawer Elevation="2" @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Persistent">
                <NavMenu />
            </MudDrawer>
            <MudDrawer Class="mud-height-full" @bind-Open="@_quickAddOpen" Anchor="@Anchor.Right" Variant="DrawerVariant.Temporary" OverlayAutoClose>
                <QuickAdd OnSelect="@(() => _quickAddOpen = false)" />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent>
        <MudContainer Class="ma-4">
            @if (_tagManagerShell.IsOpen && !_useDialogBreakpoint)
            {
                <TagManager ShowClose="true" OnClose="CloseTagManager" />
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    private bool _quickAddOpen = false;
    private bool _isDarkMode;
    private MudThemeProvider? _mudThemeProvider;
    private bool disposedValue;
    private bool _useDialogBreakpoint = true;
    private IDialogReference? _tagManagerDialog;
    private readonly Guid _viewportObserverId = Guid.NewGuid();

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
    void QuickAddToggle()
    {
        _quickAddOpen = !_quickAddOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        _useDialogBreakpoint = await _viewportService.GetCurrentBreakpointAsync() >= Breakpoint.Md;
        await _viewportService.SubscribeAsync(_viewportObserverId, OnViewportChanged, fireImmediately: false);
        _tagManagerShell.OpenChanged += OnTagManagerOpenChanged;
        _tagManagerShell.Closed += OnTagManagerClosed;

        _appContext.RangeUpdated += async (o, e) =>
        {
            await InvokeAsync(StateHasChanged);
        };

        _auth.AuthenticationStateChanged += OnAuthStateChanged;

        var response = await _clientRepository.Get<BootstrapQueryRequest, BootstrapQueryResponse>(CancellationToken.None);

        if (response.SuccessWithValue)
        {
            _startupState.NotifyStateChanged(response.Value.AuthProviders);
        }

        var authState = await _auth.GetAuthenticationStateAsync();
        await EnsureAuthenticatedSessionAsync(authState);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> authState)
    {
        _ = HandleAuthStateChanged(authState);
    }

    private async Task HandleAuthStateChanged(Task<AuthenticationState> authState)
    {
        await EnsureAuthenticatedSessionAsync(await authState);
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureAuthenticatedSessionAsync(AuthenticationState authState)
    {
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            await _appSessionBootstrap.EnsureAuthenticatedStartupAsync();
            await Task.WhenAll(_categoryState.FetchState(), _tagState.FetchState());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider != null)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnViewportChanged(BrowserViewportEventArgs args)
    {
        _useDialogBreakpoint = args.Breakpoint >= Breakpoint.Md;
        _ = InvokeAsync(HandleTagManagerPresentationAsync);
    }

    private void OnTagManagerOpenChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(HandleTagManagerPresentationAsync);
    }

    private void OnTagManagerClosed(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await _tagState.FetchState();
            StateHasChanged();
        });
    }

    private async Task HandleTagManagerPresentationAsync()
    {
        if (_tagManagerShell.IsOpen)
        {
            await _tagState.FetchState();

            if (_useDialogBreakpoint)
            {
                if (_tagManagerDialog is null)
                {
                    var options = new DialogOptions
                    {
                        MaxWidth = MaxWidth.Small,
                        FullWidth = true,
                        CloseOnEscapeKey = true
                    };

                    _tagManagerDialog = await _dialogService.ShowAsync<TagManagerDialog>(null, options);
                    _ = _tagManagerDialog.Result.ContinueWith(_ =>
                    {
                        _tagManagerDialog = null;
                        if (_tagManagerShell.IsOpen)
                        {
                            _tagManagerShell.Close();
                        }
                    }, TaskScheduler.Default);
                }
            }
        }
        else
        {
            if (_tagManagerDialog is not null)
            {
                _tagManagerDialog.Close();
                _tagManagerDialog = null;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void CloseTagManager()
    {
        _tagManagerShell.Close();
    }

    public void Dispose()
    {
        if (!disposedValue)
        {
            disposedValue = true;
            _auth.AuthenticationStateChanged -= OnAuthStateChanged;
            _ = _viewportService.UnsubscribeAsync(_viewportObserverId);
            _tagManagerShell.OpenChanged -= OnTagManagerOpenChanged;
            _tagManagerShell.Closed -= OnTagManagerClosed;
        }
    }

    private async Task OnSystemPreferenceChanged(bool newValue)
    {
        _isDarkMode = newValue;
        await InvokeAsync(StateHasChanged);
    }
}